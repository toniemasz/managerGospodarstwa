    <mxCell id="h1" value="Model bazy danych / ERD UML — Manager Gospodarstwa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry"/></mxCell>
    <mxCell id="legend1" value="Relacje są pokazane logicznie według modeli Django. Centralny kontekst bezpieczeństwa i izolacji danych: FarmModel. Większość rekordów ma FK do gospodarstwa albo pośrednio przez encję należącą do gospodarstwa." style="shape=note;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="980" y="20" width="540" height="70" as="geometry"/></mxCell>
