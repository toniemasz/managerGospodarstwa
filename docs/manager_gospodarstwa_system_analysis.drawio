</mxGraphModel></diagram>
  <diagram id="scenarios" name="3. Scenariusze"><mxGraphModel dx="1422" dy="795" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1120" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="h3" value="Najważniejsze scenariusze przepływu danych" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="850" height="50" as="geometry"/></mxCell>
    <mxCell id="legend3" value="To są praktyczne przepływy biznesowe, które warto pokazać prowadzącemu: skąd przychodzą dane, kto je waliduje, gdzie są zapisywane i jakie rekordy pochodne powstają." style="shape=note;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1"><mxGeometry x="940" y="20" width="620" height="80" as="geometry"/></mxCell>
    <mxCell id="sc1" value="&lt;b&gt;1. Przyjęcie dostawy paszy&lt;/b&gt;&lt;br&gt;Użytkownik dodaje dostawę → DeliveryForm waliduje składnik i ilość → DeliveryModel zapisuje datę, kg i cenę → InventoryMovementService.sync_delivery tworzy ruch magazynowy DELIVERY (+kg) → dashboard magazynu sumuje ruchy i pokazuje stan/niskie zapasy." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="150" width="520" height="150" as="geometry"/></mxCell>
    <mxCell id="sc2" value="&lt;b&gt;2. Utworzenie receptury&lt;/b&gt;&lt;br&gt;Użytkownik tworzy RecipeModel → RecipeItemFormSet zapisuje składniki i procenty → RecipeItemModel łączy recepturę ze składnikami → FeedManagementService/RecipeCostCalculator liczy koszt receptury na podstawie ostatnich cen dostaw." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="650" y="150" width="520" height="150" as="geometry"/></mxCell>
    <mxCell id="sc3" value="&lt;b&gt;3. Śrutowanie i FIFO&lt;/b&gt;&lt;br&gt;ProductionModel startuje jako QUEUED → etap 1 zmienia status na STAGE_1_DONE → complete_production waliduje magazyn → InventoryMovementService.book_production pobiera dostawy FIFO, tworzy ProductionIngredientUsage, zmniejsza Delivery.remaining_quantity_kg, księguje InventoryMovement PRODUCTION_USAGE (-kg) i zapisuje koszt w ProductionModel." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1240" y="150" width="640" height="180" as="geometry"/></mxCell>
    <mxCell id="sc4" value="&lt;b&gt;4. Maciory i zdarzenia&lt;/b&gt;&lt;br&gt;SowModel należy do gospodarstwa → użytkownik dodaje SowEventModel przez SowEventForm/BulkSowEventFormSet → SowEventService waliduje logikę cyklu → dashboard wylicza status maciory, badania USG, oproszenia i szczepienia." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#e1d5e7;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="410" width="520" height="150" as="geometry"/></mxCell>
    <mxCell id="sc5" value="&lt;b&gt;5. Import sprzedaży z PDF&lt;/b&gt;&lt;br&gt;Użytkownik wrzuca settlement_pdf → PigSaleForm.validate_settlement_pdf → SaleFormService.parse_pdf_import → SaleSettlementParserFactory odczytuje dane → użytkownik widzi preview → save_sale zapisuje PigSaleModel i SaleClassRowModel → recalculate_from_rows przelicza ilość, wagę i wartości." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#ffe6cc;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="650" y="410" width="520" height="170" as="geometry"/></mxCell>
    <mxCell id="sc6" value="&lt;b&gt;6. Koszty i rentowność&lt;/b&gt;&lt;br&gt;Użytkownik zapisuje CostModel z kategorią → CostService filtruje i sumuje koszty → PigSaleModel daje przychody → Feed/Production daje koszt paszy → ProfitabilityAnalyticsService łączy przychody, koszty i produkcję w widok rentowności." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#fff2cc;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1240" y="430" width="640" height="150" as="geometry"/></mxCell>
    <mxCell id="sc7" value="&lt;b&gt;7. Ustawienia, backup i audyt&lt;/b&gt;&lt;br&gt;FarmSettingsModel przechowuje parametry cyklu, UI i modułów → eksport ZIP/CSV pobiera dane gospodarstwa → import przywraca rekordy do aktualnego FarmModel → AuditLogModel zapisuje działania użytkownika oraz importy/eksporty." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="690" width="520" height="150" as="geometry"/></mxCell>
    <mxCell id="sc8" value="&lt;b&gt;8. Wyszukiwanie globalne i task center&lt;/b&gt;&lt;br&gt;Global search zbiera wyniki z modułów filtrowane po farm → TaskCenterService agreguje zadania z pasz, macior i sprzedaży → wynik trafia do templates jako kontekst dashboardowy." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="650" y="710" width="520" height="130" as="geometry"/></mxCell>
    <mxCell id="fifo1" value="&lt;b&gt;Dostawy FIFO&lt;/b&gt;&lt;br&gt;D1: 100 kg po 1.20&lt;br&gt;D2: 200 kg po 1.40" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="930" width="260" height="90" as="geometry"/></mxCell>
    <mxCell id="fifo2" value="&lt;b&gt;Wymagania produkcji&lt;/b&gt;&lt;br&gt;receptura × quantity_kg&lt;br&gt;np. śruta: 150 kg składnika" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="410" y="930" width="270" height="90" as="geometry"/></mxCell>
    <mxCell id="fifo3" value="&lt;b&gt;Alokacja FIFO&lt;/b&gt;&lt;br&gt;najpierw D1, potem D2&lt;br&gt;ProductionIngredientUsage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="760" y="930" width="290" height="90" as="geometry"/></mxCell>
    <mxCell id="fifo4" value="&lt;b&gt;Ruch magazynowy&lt;/b&gt;&lt;br&gt;InventoryMovement&lt;br&gt;PRODUCTION_USAGE = -150 kg" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1120" y="930" width="310" height="90" as="geometry"/></mxCell>
    <mxCell id="fifo5" value="&lt;b&gt;Koszt produkcji&lt;/b&gt;&lt;br&gt;feed_cost_total&lt;br&gt;feed_cost_per_kg&lt;br&gt;partial flag/note" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1500" y="930" width="290" height="90" as="geometry"/></mxCell>
    <mxCell id="e3000" value="available stock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" parent="1" edge="1" source="fifo1" target="fifo2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3001" value="book_production()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" parent="1" edge="1" source="fifo2" target="fifo3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3002" value="create movement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" parent="1" edge="1" source="fifo3" target="fifo4"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3003" value="update ProductionModel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" parent="1" edge="1" source="fifo4" target="fifo5"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3004" value="magazyn zasila produkcję" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=10;dashed=1;" parent="1" edge="1" source="sc1" target="sc3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3005" value="receptura steruje wymaganiami" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=10;dashed=1;" parent="1" edge="1" source="sc2" target="sc3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3006" value="przychody" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" parent="1" edge="1" source="sc5" target="sc6"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3007" value="koszt paszy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=10;dashed=1;" parent="1" edge="1" source="sc1" target="sc6"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3008" value="zadania/powiadomienia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;fontSize=10;dashed=1;" parent="1" edge="1" source="sc4" target="sc8"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3009" value="ustawienia widoczności" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;fontSize=10;dashed=1;" parent="1" edge="1" source="sc7" target="sc8"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root>
</mxGraphModel></diagram>
